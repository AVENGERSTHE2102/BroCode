{
  "version": 1,
  "dataClass": "synthetic_test_fixture_only",
  "researchBasis": ["part1.md §3 P4/P7/P10", "part2.md §6.6", "part3.md §10.3–10.4"],
  "cases": [
    {
      "id": "multi-hop-deploy-regression",
      "dimensions": ["multi_hop", "company_brain", "action_evidence"],
      "question": "Which recent change is the strongest lead for checkout timeouts, and what evidence supports it?",
      "principalGroups": ["oncall"],
      "nodes": [
        { "id": "incident-101", "type": "Incident", "aclGroups": ["oncall"] },
        { "id": "service-checkout", "type": "Service", "aclGroups": ["oncall"] },
        { "id": "library-tax", "type": "Repository", "aclGroups": ["oncall"] },
        { "id": "pr-44", "type": "Change", "aclGroups": ["oncall"] }
      ],
      "edges": [
        { "id": "e101", "from": "incident-101", "type": "AFFECTS", "to": "service-checkout" },
        { "id": "e102", "from": "service-checkout", "type": "DEPENDS_ON", "to": "library-tax" },
        { "id": "e103", "from": "library-tax", "type": "CHANGED_BY", "to": "pr-44" }
      ],
      "expected": {
        "outcome": "answer_with_lead",
        "claims": ["pr-44 changed library-tax, a dependency of service-checkout affected by incident-101"],
        "evidencePaths": [["incident-101", "e101", "service-checkout", "e102", "library-tax", "e103", "pr-44"]],
        "requiredControls": ["label_as_lead_not_proven_root_cause", "cite_every_claim"]
      }
    },
    {
      "id": "superseded-deployment-fact",
      "dimensions": ["changing_facts", "temporal_memory"],
      "question": "Which deployment revision is currently serving checkout?",
      "principalGroups": ["oncall"],
      "nodes": [
        { "id": "service-checkout", "type": "Service", "aclGroups": ["oncall"] },
        { "id": "revision-old", "type": "FactVersion", "value": "rev-17", "state": "superseded", "aclGroups": ["oncall"] },
        { "id": "revision-current", "type": "FactVersion", "value": "rev-18", "state": "current", "aclGroups": ["oncall"] }
      ],
      "edges": [
        { "id": "e201", "from": "service-checkout", "type": "HAS_REVISION", "to": "revision-old" },
        { "id": "e202", "from": "revision-current", "type": "SUPERSEDES", "to": "revision-old" },
        { "id": "e203", "from": "service-checkout", "type": "HAS_REVISION", "to": "revision-current" }
      ],
      "expected": {
        "outcome": "answer",
        "claims": ["rev-18 is current", "rev-17 is superseded"],
        "evidencePaths": [["service-checkout", "e203", "revision-current"], ["revision-current", "e202", "revision-old"]],
        "requiredControls": ["do_not_answer_from_superseded_fact", "cite_current_version"]
      }
    },
    {
      "id": "failed-attempt-changed-condition",
      "dimensions": ["prior_failures", "action_evidence"],
      "question": "Can the deployment rollback be retried after the previous rollback failed?",
      "principalGroups": ["oncall"],
      "nodes": [
        { "id": "attempt-1", "type": "Attempt", "outcome": "failed", "conditions": "health-check-red", "aclGroups": ["oncall"] },
        { "id": "healthcheck-change", "type": "Change", "value": "probe-fixed", "aclGroups": ["oncall"] },
        { "id": "attempt-2", "type": "Attempt", "outcome": "not_started", "conditions": "health-check-green", "aclGroups": ["oncall"] }
      ],
      "edges": [
        { "id": "e301", "from": "attempt-1", "type": "BLOCKED_BY", "to": "healthcheck-change" },
        { "id": "e302", "from": "attempt-2", "type": "CONDITION_CHANGED_BY", "to": "healthcheck-change" }
      ],
      "expected": {
        "outcome": "propose_after_changed_conditions",
        "claims": ["attempt-1 failed while the health check was red", "the health-check probe was fixed before attempt-2"],
        "evidencePaths": [["attempt-1", "e301", "healthcheck-change"], ["attempt-2", "e302", "healthcheck-change"]],
        "requiredControls": ["require_changed_condition_evidence", "require_human_approval", "do_not_claim_execution"]
      }
    },
    {
      "id": "restart-handoff-recovery",
      "dimensions": ["restart_recovery", "handoff"],
      "question": "After the prior session ended, who owns the deployment verification task?",
      "principalGroups": ["oncall"],
      "nodes": [
        { "id": "task-401", "type": "Task", "state": "in_progress", "aclGroups": ["oncall"] },
        { "id": "agent-a", "type": "Agent", "aclGroups": ["oncall"] },
        { "id": "agent-b", "type": "Agent", "aclGroups": ["oncall"] },
        { "id": "handoff-401", "type": "Handoff", "state": "acknowledged", "aclGroups": ["oncall"] }
      ],
      "edges": [
        { "id": "e401", "from": "task-401", "type": "OWNED_BY", "to": "agent-b" },
        { "id": "e402", "from": "handoff-401", "type": "HANDED_FROM", "to": "agent-a" },
        { "id": "e403", "from": "handoff-401", "type": "HANDED_TO", "to": "agent-b" },
        { "id": "e404", "from": "handoff-401", "type": "FOR_TASK", "to": "task-401" }
      ],
      "expected": {
        "outcome": "answer",
        "claims": ["agent-b owns task-401", "handoff-401 was acknowledged"],
        "evidencePaths": [["task-401", "e401", "agent-b"], ["task-401", "e404", "handoff-401", "e403", "agent-b"]],
        "requiredControls": ["recover_state_after_restart", "do_not_assign_from_unacknowledged_handoff"]
      }
    },
