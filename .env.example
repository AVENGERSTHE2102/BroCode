# Supabase project URL and publishable key. The publishable key is safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: used by the graph-projection worker. Never expose this value to client code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# FalkorDB connection URL. Use falkors:// for TLS-enabled endpoints (FalkorDB Cloud),
# or falkor:// for a plain local instance (e.g. Docker: falkor://localhost:6379).
FALKORDB_URL=falkors://default:YOUR_PASSWORD@YOUR_HOST:6379

# Server-only OpenAI-compatible chat-completions provider for the investigation agent.
# Any OpenAI-compatible provider works here (OpenAI, Groq, OpenRouter, etc.) —
# just set these three values, no code changes needed to switch providers.
# Example (Groq): AI_BASE_URL=https://api.groq.com/openai/v1, AI_MODEL=openai/gpt-oss-120b
# Example (OpenAI): AI_BASE_URL=https://api.openai.com/v1, AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Server-only GitHub App credentials for read-only repository connections.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_STATE_SECRET=
